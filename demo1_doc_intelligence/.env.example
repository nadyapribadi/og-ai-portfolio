# Copy this file to `.env` and fill in your key.
# `.env` is gitignored — never commit a real key.
#
# Free key: https://console.groq.com
GROQ_API_KEY=gsk_your_key_here

# ── Optional ─────────────────────────────────────────────────────────────────
# The public demo rations itself so one visitor cannot spend the whole day's
# free quota. Locally the key is yours, so the guard can be lifted.
# DEMO1_QUOTA_GUARD=off

# Or keep it and change the bounds (the cost contract behind them is in config.py):
# DEMO1_MAX_ANSWERS_PER_SESSION=8
# DEMO1_MAX_ANSWERS_PER_DAY=25
# DEMO1_MIN_SECONDS=4

# Answer with the larger model when quality matters more than the daily budget:
# DEMO1_ANSWER_MODEL=openai/gpt-oss-120b
