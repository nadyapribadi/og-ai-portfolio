# Repo-level TOOLING keys — not used by the demos at runtime.
# Copy to `.env` (gitignored) and fill in.
#
# Used by graphify for semantic extraction of documents. Code extraction is
# AST-based and needs no key at all. Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_key_here

# Each demo keeps its own runtime keys, e.g.
#   demo1_doc_intelligence/.env  ->  GROQ_API_KEY
# See demo1_doc_intelligence/.env.example
