# API keys - NEVER commit
.env

# Virtual environment - recreated with pip install
venv/

# Demo data - PDFs are copyrighted and never committed; vector stores are
# regenerated by ingest.py. The whole tree is ignored so that local symlinks
# into a working copy can never be committed by accident.
demo1_doc_intelligence/data/

# Python auto-generated cache files
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Tooling indexes — regenerated locally, never committed
.gitnexus/
graphify-out/

# Mac system file
.DS_Store

# Streamlit secrets
.streamlit/secrets.toml
